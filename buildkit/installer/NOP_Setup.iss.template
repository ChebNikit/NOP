[Types]
Name: "full"; Description: "{cm:TypeFull}"
Name: "compact"; Description: "{cm:TypeCompact}"
Name: "custom"; Description: "{cm:TypeCustom}"; Flags: iscustom

[Components]
Name: "core"; Description: "{cm:CompCore}"; Types: full compact custom; Flags: fixed
#ifdef HasEngines
Name: "engines"; Description: "{cm:CompEngines}"; Types: full custom
#endif

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "openwith"; Description: "{cm:TaskOpenWith}"; GroupDescription: "{cm:GroupIntegration}"

[Files]
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Excludes: "converters\*"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: core
#ifdef HasEngines
; Each converter is its own folder, installed only if ticked on the "File converters" page (or /ENGINES=name,name for a silent install).
Source: "{#PayloadDir}\converters\libreoffice\*"; DestDir: "{app}\converters\libreoffice"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: engines; Check: EngineSelected('libreoffice')
Source: "{#PayloadDir}\converters\inkscape\*"; DestDir: "{app}\converters\inkscape"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: engines; Check: EngineSelected('inkscape')
Source: "{#PayloadDir}\converters\calibre\*"; DestDir: "{app}\converters\calibre"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: engines; Check: EngineSelected('calibre')
Source: "{#PayloadDir}\converters\blender\*"; DestDir: "{app}\converters\blender"; Flags: ignoreversion recursesubdirs createallsubdirs; Components: engines; Check: EngineSelected('blender')
#endif
#ifdef VcRedist
Source: "{#VcRedist}"; DestDir: "{tmp}"; Flags: deleteafterinstall; Check: NeedsVCRedist
#endif
#ifdef ApoInstaller
; Equalizer APO is embedded and extracted on demand (see CurStepChanged); it is never copied into the NOP folder.
Source: "{#ApoInstaller}"; Flags: dontcopy
#endif

[INI]
Filename: "{app}\NOP.url"; Section: "InternetShortcut"; Key: "URL"; String: "{#AppUrl}"

[Icons]
; Start Menu folder (Start - All programs - NOP). The wizard page "Select Start Menu Folder" lets the user rename it
; or tick "Don't create a Start Menu folder"; Inno then skips every icon whose name starts with {group}\.
Name: "{group}\NOP"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"; Comment: "{#AppLong}"
Name: "{group}\{cm:IconCheck}"; Filename: "{app}\Check_NOP.bat"; WorkingDir: "{app}"
Name: "{group}\{cm:IconSite}"; Filename: "{app}\NOP.url"
Name: "{group}\{cm:UninstallProgram,NOP}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\NOP"; Filename: "{app}\{#AppExe}"; WorkingDir: "{app}"; Tasks: desktopicon

[InstallDelete]
; Older NOP installers put one loose shortcut straight into All programs; the Start Menu folder replaces it.
Type: files; Name: "{autoprograms}\NOP.lnk"
; Clean update: the program's own library folders are replaced as a whole, so no file of the previous version can be
; picked up by the new one. Never touched here: converters\ (the user's choice), anything outside {app}, and %APPDATA%\YamiFM.
Type: filesandordirs; Name: "{app}\_internal"
Type: filesandordirs; Name: "{app}\mpv"
Type: filesandordirs; Name: "{app}\licenses"

[Registry]
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "{#AppLong}"; Flags: uninsdeletekey; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\DefaultIcon"; ValueType: string; ValueData: "{app}\{#AppExe},0"; Tasks: openwith
Root: HKA; Subkey: "Software\Classes\Applications\{#AppExe}\shell\open\command"; ValueType: string; ValueData: """{app}\{#AppExe}"" ""%1"""; Tasks: openwith
#include "associations.iss.inc"

[Run]
Filename: "{tmp}\vc_redist.x64.exe"; Parameters: "/install /quiet /norestart"; StatusMsg: "{cm:StatusRuntime}"; Flags: waituntilterminated skipifdoesntexist; Check: NeedsVCRedist
; The converter check runs ONCE here (after all engines are installed) and is cached by NOP; later launches do not start any tools.
Filename: "{app}\{#AppExe}"; Parameters: "--nop-warm-capabilities"; StatusMsg: "{cm:StatusWarm}"; Flags: runasoriginaluser runhidden waituntilterminated
Filename: "{app}\{#AppExe}"; Parameters: "--nop-selftest ""{tmp}\nop-selftest.json"""; StatusMsg: "{cm:StatusSelftest}"; Flags: runasoriginaluser runhidden waituntilterminated
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchNOP}"; Flags: nowait postinstall skipifsilent runasoriginaluser

[UninstallDelete]
Type: files; Name: "{app}\*.log"
Type: files; Name: "{app}\NOP.url"

[Code]
#include "package_manifest.iss.inc"

const
  WM_CHANGEUISTATE = $0127;
  UIS_SET_HIDEFOCUS = $00010001;  { UIS_SET | (UISF_HIDEFOCUS << 16) }

function SendMessageUI(hWnd: HWND; Msg: Longint; wParam: Longint; lParam: Longint): Longint;
  external 'SendMessageW@user32.dll stdcall';

procedure HideFocusCues(hWnd: HWND);
begin
  if hWnd <> 0 then
    SendMessageUI(hWnd, WM_CHANGEUISTATE, UIS_SET_HIDEFOCUS, 0);
end;

{ Click highlight removal only: checkbox, installation-type and radio state are never changed. }
procedure DropListSelection(Sender: TObject);
begin
  WizardForm.ComponentsList.ItemIndex := -1;
end;

procedure DropControlFocus(Sender: TObject);
begin
  if WizardForm.NextButton.Visible and WizardForm.NextButton.Enabled then
    WizardForm.ActiveControl := WizardForm.NextButton;
end;

