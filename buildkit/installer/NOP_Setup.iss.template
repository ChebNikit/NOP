const
  ThemeBg     = $140F0D;
  ThemeField  = $1E1511;
  ThemeLine   = $3B2D25;
  ThemeTitle  = $FAF3F0;
  ThemeText   = $F5EDE9;
  ThemeMuted  = $AB988E;
  ThemeAccent = $6D42FF;
#endif

var
  PackageInfoPage: TWizardPage;
  PackageInfoMemo: TNewMemo;

#if Ver < 0x06060000
procedure ThemeComponents(Owner: TComponent);
var
  I: Integer;
  C: TComponent;
begin
  for I := 0 to Owner.ComponentCount - 1 do
  begin
    C := Owner.Components[I];
    if C is TNewNotebookPage then
      TNewNotebookPage(C).Color := ThemeBg
    else if C is TPanel then
      TPanel(C).Color := ThemeBg
    else if C is TBevel then
      TBevel(C).Visible := False
    else if C is TNewStaticText then
      TNewStaticText(C).Font.Color := ThemeText
    else if C is TNewCheckBox then
      TNewCheckBox(C).Font.Color := ThemeText
    else if C is TNewRadioButton then
      TNewRadioButton(C).Font.Color := ThemeText
    else if C is TEdit then
    begin
      TEdit(C).Color := ThemeField;
      TEdit(C).Font.Color := ThemeText;
    end
    else if C is TNewMemo then
    begin
      TNewMemo(C).Color := ThemeField;
      TNewMemo(C).Font.Color := ThemeText;
    end
    else if C is TNewComboBox then
    begin
      TNewComboBox(C).Color := ThemeField;
      TNewComboBox(C).Font.Color := ThemeText;
    end
    else if C is TNewCheckListBox then
    begin
      TNewCheckListBox(C).Color := ThemeField;
      TNewCheckListBox(C).Font.Color := ThemeText;
    end;
  end;
end;

procedure ReplaceBevel(Src: TBevel);
var
  Line: TPanel;
begin
  Line := TPanel.Create(WizardForm);
  Line.Parent := Src.Parent;
  Line.BevelOuter := bvNone;
  Line.Caption := '';
  Line.Color := ThemeLine;
  Line.Anchors := Src.Anchors;
  Line.SetBounds(Src.Left, Src.Top, Src.Width, 1);
end;

procedure InitializeUninstallProgressForm;
begin
  UninstallProgressForm.Color := ThemeBg;
  ThemeComponents(UninstallProgressForm);
  UninstallProgressForm.PageNameLabel.Font.Color := ThemeTitle;
  UninstallProgressForm.PageNameLabel.Font.Style := [fsBold];
  UninstallProgressForm.PageDescriptionLabel.Font.Color := ThemeMuted;
end;
#endif

var
  ApoResult: String;

function EqualizerAPOInstalled: Boolean;
var
  Folder: String;
begin
  Result := False;
  if RegQueryStringValue(HKLM64, 'SOFTWARE\EqualizerAPO', 'InstallPath', Folder) then
    Result := FileExists(AddBackslash(Folder) + 'EqualizerAPO.dll');
  if not Result then
    Result := FileExists(ExpandConstant('{commonpf64}\EqualizerAPO\EqualizerAPO.dll'));
end;

#ifdef HasEngines
#ifndef EngineMB_libreoffice
  #define EngineMB_libreoffice 0
#endif
#ifndef EngineMB_inkscape
  #define EngineMB_inkscape 0
#endif
#ifndef EngineMB_calibre
  #define EngineMB_calibre 0
#endif
#ifndef EngineMB_blender
  #define EngineMB_blender 0
#endif

const
  EngineTotal = 4;

var
  EnginePage: TWizardPage;
  EngineHeader: TNewStaticText;
  EngineNote: TNewStaticText;
  EngineList: TNewCheckListBox;
  EngineExpanded: Boolean;

function EngineName(Index: Integer): String;
begin
  case Index of
    0: Result := 'libreoffice';
    1: Result := 'inkscape';
    2: Result := 'calibre';
  else
    Result := 'blender';
  end;
end;

function EngineIndex(const Name: String): Integer;
var
  I: Integer;
begin
  Result := -1;
  for I := 0 to EngineTotal - 1 do
    if EngineName(I) = Name then
      Result := I;
end;

function EngineSizeMB(Index: Integer): Integer;
begin
  case Index of
    0: Result := {#EngineMB_libreoffice};
    1: Result := {#EngineMB_inkscape};
    2: Result := {#EngineMB_calibre};
  else
    Result := {#EngineMB_blender};
  end;
end;

function EngineDescription(Index: Integer): String;
begin
  case Index of
    0: Result := CustomMessage('EngLibreOffice');
    1: Result := CustomMessage('EngInkscape');
    2: Result := CustomMessage('EngCalibre');
  else
    Result := CustomMessage('EngBlender');
  end;
end;

function EngineLabel(Index: Integer): String;
begin
  Result := EngineDescription(Index);
  if EngineSizeMB(Index) > 0 then
    Result := Result + '  (~' + IntToStr(EngineSizeMB(Index)) + ' ' + CustomMessage('UnitMB') + ')';
end;

{ Used by [Files] (Check:). Silent installs cannot show the page, so they read /ENGINES=libreoffice,blender (default: all). }
function EngineSelected(const Name: String): Boolean;
var
  Param: String;
  Index: Integer;
begin
  Result := False;
  Index := EngineIndex(Name);
  if Index < 0 then
    Exit;
  if WizardSilent then
  begin
    Param := ',' + Lowercase(ExpandConstant('{param:engines|all}')) + ',';
    Result := (Pos(',all,', Param) > 0) or (Pos(',' + Name + ',', Param) > 0);
  end
  else if Assigned(EngineList) then
    Result := EngineList.Checked[Index];
end;

function EngineSelectedCount: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to EngineTotal - 1 do
    if EngineSelected(EngineName(I)) then
      Result := Result + 1;
end;

function EngineSelectionText: String;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to EngineTotal - 1 do
    if EngineSelected(EngineName(I)) then
    begin
      if Result <> '' then
        Result := Result + ',';
      Result := Result + EngineName(I);
    end;
  if Result = '' then
    Result := 'none';
end;

{ Remember the choice, so a later update of NOP offers the same set of converters. }
procedure RegisterPreviousData(PreviousDataKey: Integer);
begin
  if WizardIsComponentSelected('engines') then
    SetPreviousData(PreviousDataKey, 'Engines', EngineSelectionText);
end;

procedure UpdateEngineHeader;
var
  Mark: String;
begin
  if EngineExpanded then
    Mark := '▼'
  else
    Mark := '►';
  EngineHeader.Caption := Mark + '  ' + CustomMessage('EnginesHeader') + '   (' +
    FmtMessage(CustomMessage('EnginesCount'), [IntToStr(EngineSelectedCount), IntToStr(EngineTotal)]) + ')';
end;

procedure EngineHeaderClick(Sender: TObject);
begin
  EngineExpanded := not EngineExpanded;
  EngineList.Visible := EngineExpanded;
  UpdateEngineHeader;
end;

{ Same as the installation-type page: a click toggles the box but leaves no highlighted row. }
procedure EngineListClick(Sender: TObject);
begin
  EngineList.ItemIndex := -1;
  UpdateEngineHeader;
end;

procedure EngineListKeyUp(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  UpdateEngineHeader;
end;

procedure RestoreEngineSelection;
var
  Saved: String;
  I: Integer;
begin
  Saved := ',' + Lowercase(GetPreviousData('Engines', 'all')) + ',';
  if Pos(',all,', Saved) > 0 then
    Exit;
  for I := 0 to EngineTotal - 1 do
    EngineList.Checked[I] := Pos(',' + EngineName(I) + ',', Saved) > 0;
end;

procedure CreateEnginePage;
var
  I: Integer;
begin
  EnginePage := CreateCustomPage(wpSelectComponents, CustomMessage('EnginesTitle'), CustomMessage('EnginesDescription'));
  EnginePage.Surface.Color := $140F0D;
  EngineExpanded := True;

  EngineHeader := TNewStaticText.Create(EnginePage);
  EngineHeader.Parent := EnginePage.Surface;
  EngineHeader.Left := 0;
  EngineHeader.Top := 0;
  EngineHeader.Font.Style := [fsBold];
  EngineHeader.Font.Color := $FAF3F0;
  EngineHeader.Cursor := crHand;
  EngineHeader.OnClick := @EngineHeaderClick;

  EngineList := TNewCheckListBox.Create(EnginePage);
  EngineList.Parent := EnginePage.Surface;
  EngineList.Left := 0;
  EngineList.Top := EngineHeader.Top + ScaleY(26);
  EngineList.Width := EnginePage.SurfaceWidth;
  EngineList.Height := ScaleY(100);
  EngineList.Anchors := [akLeft, akTop, akRight];
  EngineList.Flat := True;
  for I := 0 to EngineTotal - 1 do
    EngineList.AddCheckBox(EngineLabel(I), '', 0, True, True, False, True, nil);
  EngineList.OnClick := @EngineListClick;
  EngineList.OnClickCheck := @EngineListClick;
  EngineList.OnKeyUp := @EngineListKeyUp;
#if Ver < 0x06060000
  EngineList.Color := ThemeField;
  EngineList.Font.Color := ThemeText;
  EngineHeader.Font.Color := ThemeTitle;
#endif

  EngineNote := TNewStaticText.Create(EnginePage);
  EngineNote.Parent := EnginePage.Surface;
  EngineNote.Left := 0;
  EngineNote.Width := EnginePage.SurfaceWidth;
  EngineNote.AutoSize := False;
  EngineNote.WordWrap := True;
  EngineNote.Height := ScaleY(48);
  EngineNote.Top := EnginePage.SurfaceHeight - EngineNote.Height;
  EngineNote.Anchors := [akLeft, akRight, akBottom];
  EngineNote.Font.Color := $AB988E;
  EngineNote.Caption := CustomMessage('EnginesNote');

  RestoreEngineSelection;
  UpdateEngineHeader;
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if Assigned(EnginePage) and (PageID = EnginePage.ID) then
    Result := not WizardIsComponentSelected('engines');
end;
#endif

function BuildPackageInfo: String;
var
  I: Integer;
begin
  if ExpandConstant('{language}') = 'russian' then
    Result := CustomMessage('PackagesAlwaysTitle') + #13#10 + PackageMediaListRu + #13#10#13#10
  else
    Result := CustomMessage('PackagesAlwaysTitle') + #13#10 + PackageMediaListEn + #13#10#13#10;
  Result := Result + CustomMessage('PackagesPythonTitle') + #13#10 +
    PackagePythonList + #13#10#13#10;
#ifdef HasEngines
  if WizardIsComponentSelected('engines') and (EngineSelectedCount > 0) then
  begin
    Result := Result + CustomMessage('PackagesEnginesTitle') + #13#10;
    for I := 0 to EngineTotal - 1 do
      if EngineSelected(EngineName(I)) then
        Result := Result + '• ' + EngineDescription(I) + #13#10;
    Result := Result + #13#10;
  end
  else
    Result := Result + CustomMessage('PackagesEnginesSkipped') + #13#10#13#10;
#else
  Result := Result + CustomMessage('PackagesEnginesUnavailable') + #13#10#13#10;
#endif
#ifdef VcRedist
  Result := Result + CustomMessage('PackagesVcRuntime') + #13#10#13#10;
#endif
#ifdef ApoInstaller
  if EqualizerAPOInstalled then
    Result := Result + CustomMessage('PackagesApoPresent') + #13#10#13#10
  else
    Result := Result + CustomMessage('PackagesApoNote') + #13#10#13#10;
#endif
  Result := Result + CustomMessage('PackagesBuildToolsNote');
end;

procedure UpdatePackageInfo;
begin
  if Assigned(PackageInfoMemo) then
    PackageInfoMemo.Text := BuildPackageInfo;
end;

procedure InitializeWizard;
var
  Bar: TPanel;
begin
#if Ver < 0x06060000
  WizardForm.Color := ThemeBg;
  ThemeComponents(WizardForm);
  WizardForm.MainPanel.Color := ThemeBg;
  WizardForm.PageNameLabel.Font.Color := ThemeTitle;
  WizardForm.PageNameLabel.Font.Style := [fsBold];
  WizardForm.PageDescriptionLabel.Font.Color := ThemeMuted;
  ReplaceBevel(WizardForm.Bevel);
  ReplaceBevel(WizardForm.Bevel1);
  WizardForm.FinishedHeadingLabel.Font.Color := ThemeTitle;
  WizardForm.DiskSpaceLabel.Font.Color := ThemeMuted;
  WizardForm.ComponentsDiskSpaceLabel.Font.Color := ThemeMuted;
  WizardForm.SelectDirBrowseLabel.Font.Color := ThemeMuted;
  Bar := TPanel.Create(WizardForm);
  Bar.Parent := WizardForm.WelcomePage;
  Bar.BevelOuter := bvNone;
  Bar.Caption := '';
  Bar.Color := ThemeAccent;
  Bar.SetBounds(WizardForm.WelcomeLabel1.Left, WizardForm.WelcomeLabel1.Top + WizardForm.WelcomeLabel1.Height + ScaleY(4), ScaleX(40), ScaleY(3));
#endif

  { Use the built-in Welcome page so the existing type-selection flow stays unchanged. }
  WizardForm.WelcomeLabel1.Caption := CustomMessage('WelcomeTitle');
  WizardForm.WelcomeLabel2.Caption := CustomMessage('WelcomeTagline') + #13#10#13#10 +
    CustomMessage('WelcomeDescription') + #13#10#13#10 + CustomMessage('WelcomeAction');

  { No highlight when clicking installation types, components and close-applications choices. }
  WizardForm.ComponentsList.OnClick := @DropListSelection;
  WizardForm.TypesCombo.OnClick := @DropControlFocus;
  WizardForm.PreparingYesRadio.OnClick := @DropControlFocus;
  WizardForm.PreparingNoRadio.OnClick := @DropControlFocus;

#ifdef HasEngines
  CreateEnginePage;
#endif

  { Standalone wizard step after type, folder and task selection; never overlays the selection page. }
  PackageInfoPage := CreateCustomPage(wpSelectTasks,
    CustomMessage('PackagesTitle'), CustomMessage('PackagesDescription'));
  PackageInfoPage.Surface.Color := $140F0D;
  PackageInfoMemo := TNewMemo.Create(PackageInfoPage);
  PackageInfoMemo.Parent := PackageInfoPage.Surface;
  PackageInfoMemo.Left := 0;
  PackageInfoMemo.Top := 0;
  PackageInfoMemo.Width := PackageInfoPage.SurfaceWidth;
  PackageInfoMemo.Height := PackageInfoPage.SurfaceHeight;
  PackageInfoMemo.Anchors := [akLeft, akTop, akRight, akBottom];
  PackageInfoMemo.ReadOnly := True;
  PackageInfoMemo.WordWrap := True;
  PackageInfoMemo.ScrollBars := ssVertical;
  PackageInfoMemo.BorderStyle := bsNone;
  PackageInfoMemo.Color := $140F0D;
  PackageInfoMemo.Font.Color := $F5EDE9;
  PackageInfoMemo.Font.Name := 'Segoe UI';
  PackageInfoMemo.Font.Size := 9;
  UpdatePackageInfo;
end;

function NeedsVCRedist: Boolean;
var
  Installed, Build: Cardinal;
begin
  // Microsoft Visual C++ 2015-2022 x64 runtime, 14.38 (build 33135) or newer. NOP also ships the DLLs privately;
  // this is only a safety net for unusual systems (for example a stripped LTSC image).
  Result := True;
  if RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Installed', Installed) and
     RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Bld', Build) then
    Result := not ((Installed = 1) and (Build >= 33135));
end;

function ReadAll(const FileName: String): String;
var
  Text: AnsiString;
begin
  Result := '';
  if LoadStringFromFile(FileName, Text) then
    Result := String(Text);
end;

#ifdef ApoInstaller
procedure CurStepChanged(CurStep: TSetupStep);
var
  ExitCode: Integer;
  Started: Boolean;
begin
  if CurStep <> ssPostInstall then Exit;
  if EqualizerAPOInstalled then
  begin
    ApoResult := CustomMessage('ApoAlready');
    Exit;
  end;
  { The Equalizer APO wizard needs a person to choose the audio device, so a silent install skips it. }
  if WizardSilent then
  begin
    ApoResult := CustomMessage('ApoSilent');
    Exit;
  end;
  WizardForm.StatusLabel.Caption := CustomMessage('StatusApo');
  ExitCode := 0;
  ExtractTemporaryFile('{#ApoFile}');
  if IsAdminInstallMode then
    Started := Exec(ExpandConstant('{tmp}\{#ApoFile}'), '', '', SW_SHOWNORMAL, ewWaitUntilTerminated, ExitCode)
  else
    Started := ShellExec('runas', ExpandConstant('{tmp}\{#ApoFile}'), '', '', SW_SHOWNORMAL, ewWaitUntilTerminated, ExitCode);
  if Started and ((ExitCode = 0) or (ExitCode = 3010)) and EqualizerAPOInstalled then
    ApoResult := CustomMessage('ApoOk')
  else
    ApoResult := CustomMessage('ApoFail');
end;
#endif

procedure CurPageChanged(CurPageID: Integer);
var
  Report, Path: String;
begin
  if CurPageID = wpSelectComponents then
  begin
    { Hide only the keyboard-focus outline; checkbox and installation-type state remain unchanged. }
    HideFocusCues(WizardForm.SelectComponentsPage.Handle);
    HideFocusCues(WizardForm.ComponentsList.Handle);
    HideFocusCues(WizardForm.TypesCombo.Handle);
    WizardForm.ComponentsList.ItemIndex := -1;
  end;

  if CurPageID = wpPreparing then
  begin
    { Hide focus indicators only within the Preparing page, including its close-applications choices. }
    if Assigned(WizardForm.PreparingMemo) then
      HideFocusCues(WizardForm.PreparingMemo.Parent.Handle);
  end;

#ifdef HasEngines
  if CurPageID = EnginePage.ID then
  begin
    HideFocusCues(EngineList.Handle);
    EngineList.ItemIndex := -1;
    UpdateEngineHeader;
  end;
#endif

  if CurPageID = PackageInfoPage.ID then
    UpdatePackageInfo;

  if CurPageID = wpFinished then
  begin
    if ApoResult <> '' then
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 + ApoResult;
    Path := ExpandConstant('{tmp}\nop-selftest.json');
    Report := ReadAll(Path);
    if Pos('"ok": true', Report) > 0 then
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 + CustomMessage('SelftestOk')
    else if Report <> '' then
    begin
      FileCopy(Path, ExpandConstant('{userdocs}\NOP-install-check.json'), False);
      WizardForm.FinishedLabel.Caption := WizardForm.FinishedLabel.Caption + #13#10#13#10 +
        FmtMessage(CustomMessage('SelftestFail'), [ExpandConstant('{userdocs}\NOP-install-check.json')]);
    end;
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Data: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    Data := ExpandConstant('{userappdata}\YamiFM');
    if (not UninstallSilent) and DirExists(Data) then
      if MsgBox(FmtMessage(CustomMessage('UninstallAskData'), [Data]), mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
        DelTree(Data, True, True, True);
  end;
end;
