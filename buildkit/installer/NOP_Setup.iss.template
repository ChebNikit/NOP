  ThemeField  = $1E1511;
  ThemeLine   = $3B2D25;
  ThemeTitle  = $FAF3F0;
  ThemeText   = $F5EDE9;
  ThemeMuted  = $AB988E;
  ThemeAccent = $6D42FF;
