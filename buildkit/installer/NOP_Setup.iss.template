#include "package_manifest.iss.inc"

const
  WM_CHANGEUISTATE = $0127;
  UIS_SET_HIDEFOCUS = $00010001;  { UIS_SET | (UISF_HIDEFOCUS << 16) }

function SendMessageUI(hWnd: HWND; Msg: Longint; wParam: Longint; lParam: Longint): Longint;
  external 'SendMessageW@user32.dll stdcall';

procedure HideFocusCues(hWnd: HWND);
begin
  if hWnd <> 0 then
    SendMessageUI(hWnd, WM_CHANGEUISTATE, UIS_SET_HIDEFOCUS, 0);
end;

{ Click highlight removal only: checkbox, installation-type and radio state are never changed. }
procedure DropListSelection(Sender: TObject);
begin
  WizardForm.ComponentsList.ItemIndex := -1;
end;

procedure DropControlFocus(Sender: TObject);
begin
  if WizardForm.NextButton.Visible and WizardForm.NextButton.Enabled then
    WizardForm.ActiveControl := WizardForm.NextButton;
end;

